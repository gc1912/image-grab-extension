{
  "manifest_version": 3,
  "name": "电商图片提取下载",
  "version": "1.0.0",
  "description": "在淘宝、京东、拼多多商品详情页提取图片，集中勾选并下载为 PNG",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "电商图片提取下载",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.alicdn.com/*",
    "*://*.taobaocdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.jd.com/*",
    "*://*.jd.hk/*",
    "*://*.360buyimg.com/*",
    "*://*.360buyimg.cn/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.pddpic.com/*",
    "*://*.ddimg.mobi/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.jd.hk/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
